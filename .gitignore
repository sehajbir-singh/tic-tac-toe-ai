# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
eggs/
*.egg-info/
*.egg
wheelhouse/
pip-wheel-metadata/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
.venv/
env/
.env/
ENV/
env.bak/
venv.bak/

# PyInstaller
#  Usually created by "pyinstaller"
dist/
build/
*.spec

# Unit test / coverage
htmlcov/
.coverage
coverage.xml
*.cover
.pytest_cache/
.tox/
.nox/
.coverage.*

# Pyright / MyPy / type-check caches
.mypy_cache/
.pyre/
.pytype/

# IDEs
.idea/
.vscode/
*.sublime-project
*.sublime-workspace
*.code-workspace

# Rope project (python refactoring lib)
.ropeproject

# IPython / Jupyter
.ipynb_checkpoints
.profile_default/
ipython_config.py

# Logs and databases
*.log
*.sql
*.sqlite3

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Sensitive files / environment settings
.env
.env.*
*.secrets
credentials.json

# Static / build outputs (if you add any front-end)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Misc
*.bak
*.swp
*~
.cache/

# Coverage reports generated by CI or tools
coverage-html/
coverage-report/

# Local user-specific files
local_settings.py

